{
	"name": "typstdrive",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"imports": {
		"#lib/ts/*": "./src/lib/ts/*.ts",
		"#lib/components/*": "./src/lib/components/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs": "mkdocs serve -f mkdocs/mkdocs.yml",
		"docs:build": "mkdocs build --strict -f mkdocs/mkdocs.yml"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-yaml": "^6.1.2",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/lsp-client": "^6.3.0",
		"@codemirror/search": "^6.7.2",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@iconify/svelte": "^5.2.3",
		"chart.js": "^4.6.1",
		"codemirror": "^6.0.2",
		"codemirror-lang-latex": "^0.6.1",
		"codemirror-lang-typst": "^0.4.0",
		"svelte-easy-crop": "^5.0.1",
		"y-codemirror.next": "^0.3.6",
		"y-websocket": "^3.1.0",
		"yaml": "^2.8.1",
		"yjs": "^13.6.33"
	}
}
