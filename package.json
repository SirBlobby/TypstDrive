{
	"name": "typstdrive",
	"private": true,
	"version": "2.3.1",
	"type": "module",
	"imports": {
		"#lib/ts/*": "./src/lib/ts/*.ts",
		"#lib/components/*": "./src/lib/components/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docs": ". venv/bin/activate && mkdocs serve -f mkdocs/mkdocs.yml",
		"docs:build": ". venv/bin/activate && mkdocs build --strict -f mkdocs/mkdocs.yml"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.104",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"vite": "^8.4.0"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/lsp-client": "^6.3.1",
		"@codemirror/search": "^6.7.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.2",
		"@iconify/svelte": "^5.2.4",
		"@lezer/highlight": "^1.2.5",
		"chart.js": "^4.6.2",
		"codemirror": "^6.0.2",
		"codemirror-lang-latex": "^0.6.2",
		"codemirror-lang-typst": "^0.6.0",
		"dompurify": "^3.5.0",
		"marked": "^18.3.0",
		"svelte-easy-crop": "^5.0.1",
		"y-codemirror.next": "^0.3.6",
		"y-websocket": "^3.1.0",
		"yaml": "^2.9.1",
		"yjs": "^13.6.33"
	},
	"overrides": {
		"postcss-selector-parser": "6.1.6"
	}
}
