# --- The basics ---
# COOKIE_SECRET=paste-the-output-of-openssl-rand-hex-64
# PUBLIC_URL=https://typst.example.com
# TRUST_PROXY_HEADERS=true
# RUST_LOG=info

# --- Database ---
# DATABASE_URL=postgres://postgres:password@db:5432/typstdrive
# DB_TYPE=postgres

# --- Email: a known provider ---
# SMTP_PROVIDER=mailgun
# SMTP_REGION=eu
# SMTP_USERNAME=postmaster@mg.example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TypstDrive <typst@mg.example.com>

# --- Email: any other server ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=typst@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TypstDrive <typst@example.com>

# --- Single sign-on ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OIDC_PROVIDERS=company
# OIDC_COMPANY_ISSUER=https://sso.example.com/realms/main
# OIDC_COMPANY_CLIENT_ID=
# OIDC_COMPANY_CLIENT_SECRET=
# OIDC_COMPANY_NAME=Company login

# --- Bigger installs ---
# REDIS_URL=redis://redis:6379
# S3_BUCKET=typstdrive
# S3_REGION=us-east-1
# S3_ENDPOINT=http://rustfs:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# OBJECT_CACHE_MB=256

# --- Security ---
# REMOTE_URLS_ALLOW_PRIVATE=false

# --- Git ---
# GIT_CACHE_DIR=/data/git-cache

# --- Citations ---
# SEMANTIC_SCHOLAR_API_KEY=
