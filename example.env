# Copy this file to .env next to docker-compose.yml. Docker Compose reads every setting from it.
# Lines starting with # are off. Remove the # to turn a setting on.

# --- The basics ---
# 64+ byte secret for signing session cookies and encrypting authenticator app secrets.
# Without it, everyone is signed out on every restart and authenticator apps cannot be set up.
# Generate one with: openssl rand -hex 64
# COOKIE_SECRET=paste-the-output-of-openssl-rand-hex-64
# Address people use to open TypstDrive. Needed for single sign-on and links in emails.
PUBLIC_URL=http://localhost:3000
# Read the client address from X-Forwarded-For when running behind a reverse proxy.
# TRUST_PROXY_HEADERS=true
# Log verbosity (default: server=debug,tower_http=debug)
# RUST_LOG=info
# Server listen port (default: 3000, also update the ports mapping in docker-compose.yml)
# PORT=3000

# --- Database ---
# SQLite is the default and needs nothing here: sqlite:///data/typstdrive.db?mode=rwc
# PostgreSQL (uncomment the db service in docker-compose.yml):
# DATABASE_URL=postgres://postgres:password@db:5432/typstdrive
# MySQL or MariaDB (uncomment the mysql service in docker-compose.yml):
# DATABASE_URL=mysql://typstdrive:password@mysql:3306/typstdrive

# --- Email: Google ---
# Turn on 2-Step Verification and create an app password.
# SMTP_PROVIDER=google
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password

# --- Email: Mailgun, SendGrid, Amazon SES, Resend, Mailjet, Microsoft 365, Fastmail ---
# SMTP_PROVIDER=mailgun
# SMTP_REGION=eu
# SMTP_USERNAME=postmaster@mg.example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TypstDrive <typst@mg.example.com>

# --- Email: any other server ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=typst@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TypstDrive <typst@example.com>

# --- Single sign-on (redirect URL: PUBLIC_URL/api/auth/sso/<id>/callback) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OIDC_PROVIDERS=company
# OIDC_COMPANY_ISSUER=https://sso.example.com/realms/main
# OIDC_COMPANY_CLIENT_ID=
# OIDC_COMPANY_CLIENT_SECRET=
# OIDC_COMPANY_NAME=Company login

# --- Bigger installs ---
# Redis or Valkey for real-time collaboration across app instances (uncomment the valkey service):
# REDIS_URL=redis://valkey:6379
# S3-compatible object storage for uploads (uncomment the rustfs service and create the bucket first):
# S3_BUCKET=typstdrive
# S3_REGION=us-east-1
# S3_ENDPOINT=http://rustfs:9000
# S3_ACCESS_KEY_ID=rustfsadmin
# S3_SECRET_ACCESS_KEY=rustfsadmin
# OBJECT_CACHE_MB=256

# --- Security ---
# REMOTE_URLS_ALLOW_PRIVATE=false
# Turns off two-factor authentication for this account when the server starts. Remove it after signing in.
# TWO_FACTOR_RESET_EMAIL=admin@example.com

# --- Git ---
# GIT_CACHE_DIR=/data/git-cache

# --- Citations ---
# SEMANTIC_SCHOLAR_API_KEY=
